{
  "extends": "@northware/tsconfig/nextjs.json",
  "compilerOptions": {
    // FIXME baseUrl is still needed in fumadocs
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/.source": [".source/*"],
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
