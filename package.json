{
  "name": "northware",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "bump-ui": "cd ./packages/ui && bun bump-ui",
    "check": "turbo fix",
    "check:root": "ultracite check",
    "commit": "commit",
    "dev": "turbo dev",
    "drizzle-generate": "cd ./packages/database && bunx drizzle-kit generate",
    "drizzle-migrate": "cd ./packages/database && bunx drizzle-kit migrate",
    "fix": "turbo fix",
    "fix:root": "ultracite fix",
    "generate-icons": "cd packages/ui && bun generate-icons",
    "lint:clerk": "eslint . --config eslint.config.mjs",
    "localci": "turbo build check --affected",
    "tsc-check": "turbo tsc-check",
    "tsc-check:root": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@changesets/cli": "^3.0.1",
    "@clerk/eslint-plugin": "0.2.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/prompt-cli": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@northware/tsconfig": "workspace:^",
    "eslint": "^10.9.1",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "ultracite": "7.10.7"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24"
  }
}
